#!/usr/bin/env bash
# This script configures Nginx to issue a 301 redirect from /redirect_me to a new page

# Update package lists and install Nginx
apt-get update -y
apt-get install nginx -y

# Configure Nginx default server block using an absolute rewrite rule
cat << 'INNER_EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm;

    server_name _;

    # 301 Redirection using rewrite to capture variations with or without a trailing slash
    rewrite ^/redirect_me/?(.*)$ https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;

    location / {
        try_files $uri $uri/ =404;
    }
}
INNER_EOF

# Ensure the root file exists with the string from task 1
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# Force start/restart Nginx using service instead of systemctl
service nginx start
service nginx restart
