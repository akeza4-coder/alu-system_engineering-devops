#!/usr/bin/env bash
# Configures an Ubuntu machine with Nginx serving 'Holberton School' at root /

# Update packages and install Nginx
sudo apt-get update -y
DEBIAN_FRONTEND=noninteractive sudo apt-get install -y nginx

# Configure the index page to serve 'Holberton School for the win!'
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null

# Restart Nginx without systemctl
sudo service nginx restart
