#!/usr/bin/env bash
# Installs Nginx and configures it to return Holberton School on port 80

# 1. Kill any existing apt processes that might be locking the installation
killall apt apt-get 2>/dev/null

# 2. Update and install Nginx
apt-get update -y
apt-get install nginx -y

# 3. Ensure the web root directory exists and overwrite the index file cleanly
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# 4. Force start/restart Nginx using service (avoiding systemctl)
service nginx start
service nginx restart
