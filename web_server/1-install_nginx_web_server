#!/usr/bin/env bash
# Configures a new Ubuntu machine with Nginx meeting all specific checker requirements

# Update and install Nginx
apt-get update -y
apt-get install nginx -y

# Configure Nginx default site configuration to ensure it serves the correct text on port 80
cat << 'INNER_EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }
}
INNER_EOF

# Ensure the web root exists and has the mandatory string
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# Start and refresh the service without using systemctl
service nginx start
service nginx restart
