#!/usr/bin/env bash
# Configures a fresh Ubuntu machine to run Nginx and serve
# a page containing "Holberton School" at the root (/) endpoint.

# Update the package list and install nginx (no interactive prompts)
apt-get update -y
apt-get install -y nginx

# Create the index page that curl / must return
echo "Holberton School!" > /var/www/html/index.html

# Restart nginx without using systemctl
service nginx restart
