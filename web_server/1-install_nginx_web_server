#!/usr/bin/env bash
# This script installs and configures Nginx to listen on port 80 and return "Holberton School" at its root.

# Update package lists
apt-get update -y

# Install Nginx
apt-get install nginx -y

# Ensure directory exists and create the required file
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# Force-start the service cleanly using service (avoiding systemctl)
service nginx start
service nginx restart
