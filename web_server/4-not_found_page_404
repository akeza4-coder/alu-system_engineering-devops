#!/usr/bin/env bash
# This script configures Nginx to have a custom 404 page containing "Ceci n'est pas une page"

# Update package lists and install Nginx
apt-get update -y
apt-get install nginx -y

# Configure Nginx default server block with custom 404 error page routing
cat << 'INNER_EOF' > /etc/nginx/sites-available/default
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm;

    server_name _;

    # Custom 404 configuration
    error_page 404 /404.html;
    location = /404.html {
        root /var/www/html;
        internal;
    }

    # 301 Redirection from previous task
    rewrite ^/redirect_me/?(.*)$ https://www.youtube.com/watch?v=QH2-TGUlwu4 permanent;

    location / {
        try_files $uri $uri/ =404;
    }
}
INNER_EOF

# Ensure the web roots exist and write the standard index file
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# Create the custom 404 HTML document with the required string
echo "Ceci n'est pas une page" > /var/www/html/404.html

# Force start/restart Nginx using service instead of systemctl
service nginx start
service nginx restart
