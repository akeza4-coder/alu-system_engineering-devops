#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page containing "Ceci n'est pas une page"

sudo apt-get update -y
DEBIAN_FRONTEND=noninteractive sudo apt-get install -y nginx

# Set root index page content
echo "Holberton School for the win!" | sudo tee /var/www/html/index.html > /dev/null

# Set custom 404 HTML file
echo "Ceci n'est pas une page" | sudo tee /usr/share/nginx/html/custom_404.html > /dev/null

# Add X-Served-By header using Nginx variable
if ! grep -q "X-Served-By" /etc/nginx/nginx.conf; then
    sudo sed -i '/http {/a \    add_header X-Served-By "$hostname";' /etc/nginx/nginx.conf
fi

# Add 404 error page configuration
if ! grep -q "custom_404.html" /etc/nginx/sites-available/default; then
    sudo sed -i '/server_name _;/a \    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        root /usr/share/nginx/html;\n        internal;\n    }' /etc/nginx/sites-available/default
fi

sudo nginx -t && sudo service nginx restart
