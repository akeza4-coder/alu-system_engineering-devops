#!/usr/bin/env bash
# Installs and configures HAProxy to load balance traffic between web-01 and web-02 using roundrobin

# Update package lists and install HAProxy
sudo apt-get update -y
DEBIAN_FRONTEND=noninteractive sudo apt-get install -y haproxy

# Enable HAProxy init script management
sudo sed -i 's/ENABLED=0/ENABLED=1/' /etc/default/haproxy

# Append frontend and backend configuration to /etc/haproxy/haproxy.cfg
if ! grep -q "frontend http_front" /etc/haproxy/haproxy.cfg; then
cat << 'HAPROXY_CONFIG' | sudo tee -a /etc/haproxy/haproxy.cfg > /dev/null

frontend http_front
    bind *:80
    mode http
    default_backend http_back

backend http_back
    mode http
    balance roundrobin
    server 7086-web-01 44.203.87.180:80 check
    server 7086-web-02 44.202.132.213:80 check
HAPROXY_CONFIG
fi

# Restart HAProxy using init service script
sudo service haproxy restart
