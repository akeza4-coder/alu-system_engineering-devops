#!/usr/bin/env bash
# Configures Nginx with a custom HTTP response header named X-Served-By containing the hostname

# Update package lists
apt-get update -y

# Install Nginx web server
apt-get install nginx -y

# Insert the X-Served-By header directive inside the default Nginx server configuration block
sed -i '/listen 80 default_server;/a \add_header X-Served-By $hostname;' /etc/nginx/sites-available/default

# Create the standard web root file with the validation string from previous web server tasks
mkdir -p /var/www/html
echo "Holberton School for the win!" > /var/www/html/index.html

# Start and restart the service safely without systemctl
service nginx start
service nginx restart
