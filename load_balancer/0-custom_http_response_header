#!/usr/bin/env bash
# Configures Nginx to add a custom X-Served-By response header
# containing the server's hostname

# shellcheck disable=SC2154

# Update package list
apt-get update

# Install nginx non-interactively
apt-get install -y nginx

# Custom index page nginx will serve
echo "Holberton School for the win!" > /var/www/html/index.html

# Add the X-Served-By header (value = server hostname) inside
# the default server block, right after "listen 80 default_server;"
sed -i "/listen 80 default_server;/a\\\tadd_header X-Served-By \$HOSTNAME always;" /etc/nginx/sites-enabled/default

# Restart nginx to apply the config change (systemctl not allowed)
service nginx restart
