#!/usr/bin/env bash
# Configures Nginx to run as nginx user and listen on port 8080

# 1. Safely replace port 80 with 8080
sed -i 's/listen 80 default_server;/listen 8080 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen \[::\]:80 default_server;/listen \[::\]:8080 default_server;/g' /etc/nginx/sites-available/default
sed -i 's/listen 80;/listen 8080;/g' /etc/nginx/sites-available/default

# 2. Stop any active Nginx processes
service nginx stop
pkill nginx

# 3. Ensure proper ownership for the nginx user
chown -R nginx:nginx /var/lib/nginx /var/log/nginx /etc/nginx

# 4. Start Nginx under the nginx user
su -c "nginx" nginx
