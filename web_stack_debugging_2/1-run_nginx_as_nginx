#!/usr/bin/env bash
# Configures Nginx to run as nginx user listening on port 8080

# Change port 80 to 8080 in all site configuration files
sed -i 's/80/8080/g' /etc/nginx/sites-available/default

# Change user directive in main nginx.conf
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf

# Give full permissions of Nginx directories to the nginx user
chown -R nginx:nginx /var/log/nginx
chown -R nginx:nginx /var/lib/nginx
chown -R nginx:nginx /var/run

# Stop any running instances of Nginx
service nginx stop

# Run Nginx as the nginx user
su -c "nginx" nginx
