#!/usr/bin/env bash
# Configures Nginx to run as the nginx user listening on port 8080

# Fix listen port in default site configuration
sed -i 's/80/8080/g' /etc/nginx/sites-available/default

# Change user directive in nginx.conf to nginx
sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/user root;/user nginx;/g' /etc/nginx/nginx.conf

# Restart service to apply changes
service nginx restart
