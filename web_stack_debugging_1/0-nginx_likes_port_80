#!/usr/bin/env bash
# Fixes Nginx configuration to listen on port 80 and restarts Nginx

# Replace port 8080 or any other custom port with 80 in default sites
sed -i 's/listen [0-9]\+/listen 80/g' /etc/nginx/sites-available/default
sed -i 's/8080/80/g' /etc/nginx/sites-available/default

# Stop apache if running (prevents port 80 conflict)
service apache2 stop 2>/dev/null || true

# Start/restart nginx
service nginx restart
